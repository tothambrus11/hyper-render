 /// Whether two elements have the same same presentational attributes.
+///
+/// First checks pointer identity (fast path), then falls back to value comparison,
+/// mirroring `have_same_style_attribute`.
 pub fn have_same_presentational_hints<E>(
     target: &mut StyleSharingTarget<E>,
     candidate: &mut StyleSharingCandidate<E>,
+    shared_context: &SharedStyleContext,
 ) -> bool
 where
     E: TElement,
 {
-    target.pres_hints() == candidate.pres_hints()
+    if target.pres_hints() == candidate.pres_hints() {
+        return true;
+    }
+    let guard = shared_context.guards.author;
+    let t = target.pres_hints();
+    let c = candidate.pres_hints();
+    if t.len() != c.len() {
+        return false;
+    }
+    t.iter().zip(c.iter()).all(|(a, b)| {
+        a.specificity == b.specificity
+            && a.cascade_priority == b.cascade_priority
+            && *a.source.read(guard) == *b.source.read(guard)
+    })
 }
 
